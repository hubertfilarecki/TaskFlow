@{
    ViewData["Title"] = "TaskFlow";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold">TaskFlow</h1>

        <p class="lead">
            System zarządzania zadaniami dla zespołów programistycznych.
        </p>
    </div>

    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4>Projekty</h4>
                    <p>Tworzenie i zarządzanie projektami.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4>Zadania</h4>
                    <p>Dodawanie i przypisywanie zadań.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4>Kanban</h4>
                    <p>Przeciąganie zadań pomiędzy kolumnami.</p>
                </div>
            </div>
        </div>

    </div>

</div>